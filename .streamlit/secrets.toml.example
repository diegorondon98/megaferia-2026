# Copiar a .streamlit/secrets.toml y completar con valores reales.
# En Streamlit Cloud: pegar este bloque en Settings -> Secrets.

[supabase]
url = "https://TU-PROYECTO.supabase.co"
# Usa la anon key (publica). La service_role la pones solo si la app debe escribir sin login.
key = "TU-ANON-KEY"

[admin]
